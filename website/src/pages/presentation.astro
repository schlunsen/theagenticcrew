</style>

<script>
  function initDeck() {
    const deck = document.getElementById('deck');
    if (!deck) return;
    const slides = Array.from(deck.querySelectorAll<HTMLElement>('.sl'));
    const total = slides.length;
    const $ = <E extends HTMLElement>(sel: string) => deck.querySelector<E>(sel)!;
    const countEl = $('[data-count]');
    const progress = $('[data-progress]');
    const status = $('[data-status]');
    const playBtn = $<HTMLButtonElement>('[data-play]');
    const notesPanel = $('[data-notes]');
    const notesBody = $('[data-notes-body]');

    const store = {
      get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } },
      set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* ignore */ } },
    };
    let lang = store.get('deck-lang') === 'es' ? 'es' : 'en';
    let current = 0;
    let playing = false;
    let audio: HTMLAudioElement | null = null;
    let timer: number | undefined;

    const setPressed = (sel: string, attr: string, val: string) =>
      deck.querySelectorAll<HTMLButtonElement>(sel).forEach((b) => b.setAttribute('aria-pressed', String(b.getAttribute(attr) === val)));

    function applyLang() {
      deck!.dataset.lang = lang;
      document.documentElement.lang = lang;
      setPressed('[data-set-lang]', 'data-set-lang', lang);
      renderNotes();
    }

    function renderNotes() {
      const tpl = slides[current].querySelector<HTMLTemplateElement>('template.sl-notes');
      notesBody.innerHTML = tpl ? tpl.innerHTML : '';
    }

    function stopAudio() {
      if (timer) { clearTimeout(timer); timer = undefined; }
      if (audio) { audio.pause(); audio.src = ''; audio = null; }
      status.textContent = '';
    }

    function readingTime(el: HTMLElement) {
      const words = (el.querySelector('.sl__inner')?.textContent || '').split(/\s+/).length / 2; // both languages rendered
      return Math.min(16000, Math.max(7000, words * 330));
    }

    function narrate() {
      stopAudio();
      if (!playing) return;
      const s = slides[current];
      const file = s.dataset.audio;
      const advance = () => { if (current < total - 1) { go(current + 1); } else { setPlaying(false); } };
      const silent = () => {
        status.textContent = lang === 'es' ? 'Sin narración todavía' : 'Narration coming soon';
        timer = window.setTimeout(advance, readingTime(s));
      };
      if (!file) return silent();
      const a = new Audio(`/presentation-audio/slide-${file}${lang === 'es' ? '-es' : ''}.mp3`);
      audio = a;
      a.addEventListener('ended', () => { timer = window.setTimeout(advance, 900); });
      a.addEventListener('error', () => { if (audio === a) silent(); });
      a.play().catch(() => { if (audio === a) silent(); });
    }

    function setPlaying(on: boolean) {
      playing = on;
      playBtn.setAttribute('aria-pressed', String(on));
      if (on) narrate(); else stopAudio();
    }

    function go(i: number) {
      const next = Math.max(0, Math.min(total - 1, i));
      current = next;
      slides.forEach((s, k) => {
        s.classList.toggle('is-active', k === next);
        s.classList.toggle('is-before', k < next);
        s.setAttribute('aria-hidden', String(k !== next));
      });
      countEl.textContent = String(next + 1);
      progress.style.width = `${((next + 1) / total) * 100}%`;
      history.replaceState(null, '', `#${next + 1}`);
      renderNotes();
      if (playing) narrate();
    }

    deck.querySelector('[data-prev]')!.addEventListener('click', () => go(current - 1));
    deck.querySelector('[data-next]')!.addEventListener('click', () => go(current + 1));
    playBtn.addEventListener('click', () => setPlaying(!playing));
    deck.querySelectorAll<HTMLButtonElement>('[data-set-lang]').forEach((b) => b.addEventListener('click', () => {
      lang = b.dataset.setLang === 'es' ? 'es' : 'en'; store.set('deck-lang', lang); applyLang(); if (playing) narrate();
    }));
    const notesBtn = $<HTMLButtonElement>('[data-notes-toggle]');
    const toggleNotes = () => { notesPanel.hidden = !notesPanel.hidden; notesBtn.setAttribute('aria-pressed', String(!notesPanel.hidden)); };
    notesBtn.addEventListener('click', toggleNotes);
    const toggleFs = () => { if (document.fullscreenElement) document.exitFullscreen(); else deck.requestFullscreen?.().catch(() => {}); };
    $('[data-fullscreen]').addEventListener('click', toggleFs);

    const onKey = (e: KeyboardEvent) => {
      if (!document.getElementById('deck')) { document.removeEventListener('keydown', onKey); return; }
      if (e.target instanceof HTMLInputElement) return;
      switch (e.key) {
        case 'ArrowRight': case 'PageDown': case ' ': e.preventDefault(); go(current + 1); break;
        case 'ArrowLeft': case 'PageUp': e.preventDefault(); go(current - 1); break;
        case 'Home': go(0); break;
        case 'End': go(total - 1); break;
        case 'n': case 'N': toggleNotes(); break;
        case 'f': case 'F': toggleFs(); break;
        case 'p': case 'P': setPlaying(!playing); break;
      }
    };
    document.addEventListener('keydown', onKey);

    let touchX: number | null = null;
    deck.addEventListener('touchstart', (e) => { touchX = e.touches[0].clientX; }, { passive: true });
    deck.addEventListener('touchend', (e) => {
      if (touchX === null) return;
      const dx = e.changedTouches[0].clientX - touchX; touchX = null;
      if (Math.abs(dx) > 50) go(current + (dx < 0 ? 1 : -1));
    });

    document.addEventListener('astro:before-swap', () => { stopAudio(); document.removeEventListener('keydown', onKey); }, { once: true });

    applyLang();
    const fromHash = parseInt(location.hash.slice(1), 10);
    go(Number.isFinite(fromHash) ? fromHash - 1 : 0);
  }
  document.addEventListener('astro:page-load', initDeck);
</script>
