    background: rgba(10,14,26,0.95); border: 1px solid var(--line-dark-strong); border-radius: var(--radius); padding: 1rem 1.2rem; font-size: 0.95rem; color: var(--cream-muted); }
  .deck__notes [data-notes-body] { margin-top: 0.5rem; }

  .deck__bar { border-top: 1px solid var(--line-dark); background: rgba(10,14,26,0.6); }
