  .trifecta__c--0 span { transform: translate(-24%, -16%); max-width: 60%; } .trifecta__c--1 span { transform: translate(24%, -16%); max-width: 60%; } .trifecta__c--2 span { transform: translateY(22%); }
  .sl--trifecta .sl-body { text-align: center; margin-left: auto; margin-right: auto; }
  .sl--trifecta .sl-h, .sl--trifecta .eyebrow { text-align: center; margin-left: auto; margin-right: auto; }
  .sl--trifecta .sl__inner { text-align: center; }
  .sl--trifecta .sl-h { margin-bottom: 1.4rem; }

  .crewmap { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line-dark); border: 1px solid var(--line-dark); border-radius: var(--radius); overflow: hidden; }
