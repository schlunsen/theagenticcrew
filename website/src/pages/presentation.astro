  .play[aria-pressed="true"] .play__icon::before { content: '❚❚'; } .play[aria-pressed="true"] .play__icon { font-size: 0; } .play[aria-pressed="true"] .play__icon::before { font-size: 0.7rem; }
  .deck__progress { flex: 1; height: 2px; background: var(--line-dark); border-radius: 2px; overflow: hidden; }
