---
import BaseLayout from '../layouts/BaseLayout.astro';
import Helm from '../components/home/Helm.astro';
import '../styles/home.css';

// Bilingual text: [english, spanish]. May contain inline HTML (<em>, <br/>).
type T = [string, string];
interface Slide {
  id: string;
  layout: 'title' | 'statement' | 'cards' | 'spectrum' | 'versus' | 'trifecta' | 'loop' | 'crew' | 'cta';
  audio?: string;          // narration file number: presentation-audio/slide-NN.mp3 (+ -es); scripts in scripts/narration/presentation.json
  notes: T;                // speaker notes / narration script
  eyebrow?: T;
  heading?: T;
  quote?: T;
  body?: T;
  items?: { title: T; body?: T; tag?: T }[];
}

const slides: Slide[] = [
  {
    id: 'title', layout: 'title', audio: '01',
    notes: ['Welcome everyone. This is a talk about how software engineering is changing in the age of AI agents.',
            'Bienvenidos. Esta es una charla sobre cómo está cambiando la ingeniería de software en la era de los agentes de IA.'],
  },
  {
    id: 'new', layout: 'cards', audio: '02',
    notes: ['The first edition came out in March 2026. Six months later, a lot had moved: instruction files converged, cloud agents started sending pull requests, and prompt injection became a string of real incidents. The second edition adds two new chapters — on the agent attack surface and on building your own agents — and moves the perishable details into one dated appendix.',
            'La primera edición salió en marzo de 2026. Seis meses después, mucho había cambiado: los archivos de instrucciones convergieron, los agentes en la nube empezaron a enviar pull requests y la inyección de prompts se convirtió en una serie de incidentes reales. La segunda edición añade dos capítulos nuevos — sobre la superficie de ataque del agente y sobre construir tus propios agentes — y mueve los detalles perecederos a un apéndice fechado.'],
    eyebrow: ['Second edition · September 2026', 'Segunda edición · Septiembre 2026'],
    heading: ['Six months is a long time <em>at sea.</em>', 'Seis meses es mucho tiempo <em>en el mar.</em>'],
    items: [
      { tag: ['New chapter', 'Capítulo nuevo'], title: ['The Agent Attack Surface', 'La superficie de ataque del agente'], body: ['Prompt injection, poisoned tools, slopsquatting.', 'Inyección de prompts, herramientas envenenadas, slopsquatting.'] },
      { tag: ['New chapter', 'Capítulo nuevo'], title: ['Building Your Own Agents', 'Construye tus propios agentes'], body: ['Own the loop, the context, and the control flow.', 'Controla el bucle, el contexto y el flujo.'] },
      { tag: ['Rewritten', 'Reescrito'], title: ['Context engineering', 'Ingeniería de contexto'], body: ['Compaction, sub-agents, AGENTS.md, skills, hooks.', 'Compactación, subagentes, AGENTS.md, skills, hooks.'] },
      { tag: ['New appendix', 'Apéndice nuevo'], title: ['The State of the Tools', 'El estado de las herramientas'], body: ['The perishable details, in one dated place.', 'Los detalles perecederos, en un solo lugar fechado.'] },
    ],
  },
  {
    id: 'shift', layout: 'statement', audio: '03',
    notes: ['For two decades, the feedback loop was simple: write code, run it, ship it. AI agents are fundamentally changing that loop.',
            'Durante dos décadas, el ciclo fue simple: escribir código, ejecutarlo, desplegarlo. Los agentes de IA están cambiando ese ciclo de raíz.'],
    eyebrow: ['The ground is shifting', 'El terreno está cambiando'],
    heading: ['You write code, you ship it. <em>That loop is breaking.</em>', 'Escribes código, lo despliegas. <em>Ese ciclo se está rompiendo.</em>'],
    items: [
      { title: ['Old loop', 'Antes'], body: ['write → run → ship', 'escribir → ejecutar → desplegar'] },
      { title: ['New loop', 'Ahora'], body: ['instruct → review → steer', 'instruir → revisar → dirigir'] },
      { title: ['Measured, not felt', 'Medido, no sentido'], body: ['In METR’s 2025 trial, experienced developers were ~19% slower with AI — while feeling ~20% faster.', 'En el ensayo de METR de 2025, desarrolladores expertos fueron ~19% más lentos con IA — sintiéndose ~20% más rápidos.'] },
    ],
  },
  {
    id: 'molting', layout: 'statement', audio: '04',
    notes: ['The craft is evolving. The mechanical parts are being automated, but the judgment, taste, and architectural thinking are more important than ever.',
            'El oficio está evolucionando. Las partes mecánicas se automatizan, pero el juicio, el gusto y el pensamiento arquitectónico importan más que nunca.'],
    eyebrow: ['From the foreword', 'Del prólogo'],
    heading: ['The craft isn’t dying. It’s <em>molting.</em>', 'El oficio no está muriendo. Está <em>mudando.</em>'],
    body: ['The keystrokes and boilerplate fall away. Systems thinking, taste, and judgement become the whole game.', 'Las pulsaciones y el código repetitivo desaparecen. El pensamiento sistémico, el gusto y el juicio lo son todo.'],
  },
  {
    id: 'agent', layout: 'spectrum', audio: '05',
    notes: ['Agents exist on a spectrum. Most practical work today happens at the tool-using agent level, where the agent can call tools, read files, and iterate.',
            'Los agentes existen en un espectro. La mayor parte del trabajo práctico hoy ocurre en el nivel del agente con herramientas, que puede llamar herramientas, leer archivos e iterar.'],
    eyebrow: ['What is an agent?', '¿Qué es un agente?'],
    heading: ['Model + tools + loop + <em>harness.</em>', 'Modelo + herramientas + bucle + <em>arnés.</em>'],
    items: [
      { title: ['Autocomplete', 'Autocompletado'], body: ['Suggests the next line.', 'Sugiere la siguiente línea.'] },
      { title: ['Copilot', 'Copiloto'], body: ['Generates on request.', 'Genera cuando se lo pides.'] },
      { title: ['Tool-using agent', 'Agente con herramientas'], body: ['Reads, runs, iterates. Most real work happens here.', 'Lee, ejecuta, itera. Aquí ocurre casi todo el trabajo real.'] },
      { title: ['Background agent', 'Agente en segundo plano'], body: ['Takes a task, returns a pull request.', 'Toma una tarea y devuelve un pull request.'] },
    ],
  },
  {
    id: 'rainman', layout: 'versus', audio: '06',
    notes: ['Think of it like Rain Man. Tom Cruise provides the direction and judgment. Dustin Hoffman provides extraordinary capability but needs guidance.',
            'Piénsalo como Rain Man. Tom Cruise aporta la dirección y el juicio. Dustin Hoffman aporta una capacidad extraordinaria, pero necesita guía.'],
    eyebrow: ['The Rain Man analogy', 'La analogía de Rain Man'],
    heading: ['You’re Tom Cruise. The agent is <em>Dustin Hoffman.</em>', 'Tú eres Tom Cruise. El agente es <em>Dustin Hoffman.</em>'],
    items: [
      { title: ['You — the captain', 'Tú — el capitán'], body: ['Direction and vision · Judgement and taste · Knows when to walk away', 'Dirección y visión · Juicio y gusto · Sabe cuándo retirarse'] },
      { title: ['The agent — the savant', 'El agente — el savant'], body: ['Speed and throughput · Tireless execution · Pattern recognition at scale', 'Velocidad y rendimiento · Ejecución incansable · Reconocimiento de patrones a escala'] },
    ],
  },
  {
    id: 'capabilities', layout: 'cards', audio: '07',
    notes: ['These are the three core capabilities that make an agent an agent: planning, tool use, and iteration. Without any one of these, you just have a chatbot.',
            'Estas son las tres capacidades que hacen que un agente sea un agente: planificación, uso de herramientas e iteración. Sin cualquiera de ellas, solo tienes un chatbot.'],
    eyebrow: ['Three core capabilities', 'Tres capacidades fundamentales'],
    heading: ['Without any one of these, it’s <em>just a chatbot.</em>', 'Sin cualquiera de ellas, es <em>solo un chatbot.</em>'],
    items: [
      { tag: ['i', 'i'], title: ['Planning', 'Planificación'], body: ['Breaks a goal into ordered, verifiable steps.', 'Divide un objetivo en pasos ordenados y verificables.'] },
      { tag: ['ii', 'ii'], title: ['Tool use', 'Uso de herramientas'], body: ['Reads files, runs commands, calls APIs. The tools are the promotion.', 'Lee archivos, ejecuta comandos, llama APIs. Las herramientas son el ascenso.'] },
      { tag: ['iii', 'iii'], title: ['Iteration', 'Iteración'], body: ['Act, observe, adjust — until the tests are green.', 'Actuar, observar, ajustar — hasta que los tests pasen.'] },
    ],
  },
  {
    id: 'fail', layout: 'cards', audio: '08',
    notes: ['Understanding failure modes is critical. These are the four most common ways agents go wrong, and how to mitigate each one.',
            'Entender los modos de fallo es crucial. Estas son las cuatro formas más comunes en que los agentes fallan, y cómo mitigar cada una.'],
    eyebrow: ['When agents fail', 'Cuando los agentes fallan'],
    heading: ['Every failure mode has a <em>mitigation.</em>', 'Cada modo de fallo tiene una <em>mitigación.</em>'],
    items: [
      { tag: ['Fix: tight scope', 'Solución: alcance acotado'], title: ['Scope creep', 'Expansión del alcance'], body: ['You asked for a bug fix; it refactored thirty files.', 'Pediste un arreglo; refactorizó treinta archivos.'] },
      { tag: ['Fix: run the tests', 'Solución: ejecutar los tests'], title: ['Hallucinated APIs', 'APIs alucinadas'], body: ['Plausible code against libraries that don’t exist.', 'Código plausible contra librerías que no existen.'] },
      { tag: ['Fix: verify', 'Solución: verificar'], title: ['Overconfidence', 'Exceso de confianza'], body: ['A sleep() and a mutex arrive with the same certainty.', 'Un sleep() y un mutex llegan con la misma certeza.'] },
      { tag: ['Fix: compact, start fresh', 'Solución: compactar, empezar de nuevo'], title: ['Context loss', 'Pérdida de contexto'], body: ['Constraints from an hour ago quietly fade.', 'Las restricciones de hace una hora se desvanecen.'] },
    ],
  },
  {
    id: 'toolkit', layout: 'cards', audio: '09',
    notes: ['These five practices form the engineering toolkit for working with agents effectively. Each one reinforces the others.',
            'Estas cinco prácticas forman el kit de ingeniería para trabajar con agentes de forma eficaz. Cada una refuerza a las demás.'],
    eyebrow: ['The engineering toolkit', 'El kit de ingeniería'],
    heading: ['The boring things <em>win.</em>', 'Lo aburrido <em>gana.</em>'],
    items: [
      { title: ['Context', 'Contexto'], body: ['What the agent can see — and reach.', 'Lo que el agente puede ver — y alcanzar.'] },
      { title: ['Guardrails', 'Barandillas'], body: ['Permissions, hooks, sandboxes.', 'Permisos, hooks, sandboxes.'] },
      { title: ['Tests', 'Tests'], body: ['The agent’s eyes.', 'Los ojos del agente.'] },
      { title: ['Conventions', 'Convenciones'], body: ['AGENTS.md, skills, structure.', 'AGENTS.md, skills, estructura.'] },
      { title: ['Memory', 'Memoria'], body: ['The ship’s log across sessions.', 'El cuaderno de bitácora entre sesiones.'] },
    ],
  },
  {
    id: 'context', layout: 'loop', audio: '10',
    notes: ['Context engineering is the discipline of deciding what goes into the model’s window. Bigger windows didn’t remove the tax — performance still degrades as context grows. So research first, then plan, then implement, with a fresh or compacted context between each phase, and use sub-agents to explore without polluting the main window.',
            'La ingeniería de contexto es la disciplina de decidir qué entra en la ventana del modelo. Las ventanas más grandes no eliminaron el coste — el rendimiento sigue degradándose a medida que crece el contexto. Así que primero investiga, luego planifica, luego implementa, con un contexto nuevo o compactado entre cada fase, y usa subagentes para explorar sin contaminar la ventana principal.'],
    eyebrow: ['Context engineering', 'Ingeniería de contexto'],
    heading: ['Bigger windows didn’t remove <em>the tax.</em>', 'Las ventanas más grandes no eliminaron <em>el coste.</em>'],
    items: [
      { title: ['Research', 'Investigar'], body: ['Sub-agents explore; only a summary comes back.', 'Los subagentes exploran; solo vuelve un resumen.'] },
      { title: ['Plan', 'Planificar'], body: ['A written plan you review before any code changes.', 'Un plan escrito que revisas antes de cambiar código.'] },
      { title: ['Implement', 'Implementar'], body: ['Fresh, compacted context. Tests as the signal.', 'Contexto nuevo y compactado. Los tests como señal.'] },
    ],
  },
  {
    id: 'trifecta', layout: 'trifecta', audio: '11',
    notes: ['The biggest gap in the first edition was security. An agent that has access to private data, is exposed to untrusted content, and has a way to communicate externally can be tricked into leaking that data. Simon Willison calls it the lethal trifecta. You can’t fully prevent prompt injection yet — so remove at least one leg for any session.',
            'La mayor carencia de la primera edición era la seguridad. Un agente con acceso a datos privados, expuesto a contenido no confiable y con una forma de comunicarse hacia fuera puede ser engañado para filtrar esos datos. Simon Willison lo llama la tríada letal. Aún no puedes evitar del todo la inyección de prompts — así que elimina al menos una pata en cada sesión.'],
    eyebrow: ['The agent attack surface', 'La superficie de ataque del agente'],
    heading: ['Remove one leg of <em>the lethal trifecta.</em>', 'Elimina una pata de <em>la tríada letal.</em>'],
    items: [
      { title: ['Private data', 'Datos privados'] },
      { title: ['Untrusted content', 'Contenido no confiable'] },
      { title: ['A way out', 'Una salida al exterior'] },
    ],
    body: ['An agent that reads a stranger’s text with your keys in its pocket works for whoever wrote the text.', 'Un agente que lee el texto de un desconocido con tus llaves en el bolsillo trabaja para quien escribió ese texto.'],
  },
  {
    id: 'cloud', layout: 'statement', audio: '12',
    notes: ['The overnight agent I described as a shell script became a product feature. You assign an issue, and a pull request comes back. That makes agent capacity cheap. What isn’t cheap is human attention — a dozen pull requests still need someone who understands every one of them. Plan your work around the reviewer, not the agents.',
            'El agente nocturno que describí como un script se convirtió en una función de producto. Asignas un issue y vuelve un pull request. Eso abarata la capacidad de los agentes. Lo que no es barato es la atención humana — una docena de pull requests sigue necesitando a alguien que entienda cada uno. Planifica el trabajo en torno al revisor, no a los agentes.'],
    eyebrow: ['Agents in the pipeline', 'Agentes en el pipeline'],
    heading: ['Agents are cheap now. <em>Attention isn’t.</em>', 'Los agentes ya son baratos. <em>La atención no.</em>'],
    items: [
      { title: ['Assign an issue', 'Asigna un issue'], body: ['A cloud agent works in a sandbox.', 'Un agente en la nube trabaja en un sandbox.'] },
      { title: ['Get a pull request', 'Recibe un pull request'], body: ['Tests, a diff, a summary.', 'Tests, un diff, un resumen.'] },
      { title: ['Review is the bottleneck', 'La revisión es el cuello de botella'], body: ['Plan around the reviewer, not the agents.', 'Planifica en torno al revisor, no a los agentes.'] },
    ],
  },
  {
    id: 'build', layout: 'statement', audio: '13',
    notes: ['Once you build agents yourself, you see how much of what feels like the model being smart is really the loop around it: what goes into the context, which tools exist, when it stops, and what it is allowed to touch. The loop is small. Everything around it is the work — and that part is engineering.',
            'Cuando construyes agentes tú mismo, ves cuánto de lo que parece inteligencia del modelo es en realidad el bucle que lo rodea: qué entra en el contexto, qué herramientas existen, cuándo se detiene y qué puede tocar. El bucle es pequeño. Todo lo que lo rodea es el trabajo — y esa parte es ingeniería.'],
    eyebrow: ['Building your own agents', 'Construye tus propios agentes'],
    heading: ['The loop is small. <em>The harness is the work.</em>', 'El bucle es pequeño. <em>El arnés es el trabajo.</em>'],
    items: [
      { title: ['Own the context', 'Controla el contexto'], body: ['You build the prompt every turn.', 'Construyes el prompt en cada turno.'] },
      { title: ['Own the control flow', 'Controla el flujo'], body: ['Budgets, stop conditions, escalation.', 'Presupuestos, condiciones de parada, escalado.'] },
      { title: ['Humans as a tool call', 'Humanos como una llamada'], body: ['Pause, persist, resume when they answer.', 'Pausa, persiste, reanuda cuando respondan.'] },
      { title: ['Evals are your tests', 'Las evals son tus tests'], body: ['Run them on every prompt or model change.', 'Ejecútalas en cada cambio de prompt o modelo.'] },
    ],
  },
  {
    id: 'wee', layout: 'statement', audio: '14',
    notes: ['I built Wee Editor to practice what the book preaches: a self-hosted workspace for running many agent sessions in parallel — each in its own worktree, with its own permissions, and with visibility into what every agent is doing. The best way to learn agentic engineering is to build agentic tooling.',
            'Construí Wee Editor para practicar lo que predica el libro: un espacio de trabajo autoalojado para ejecutar muchas sesiones de agentes en paralelo — cada una en su propio worktree, con sus propios permisos y con visibilidad de lo que hace cada agente. La mejor manera de aprender ingeniería agéntica es construir herramientas agénticas.'],
    eyebrow: ['Orchestration in practice', 'Orquestación en la práctica'],
    heading: ['Build the tooling. <em>Learn the craft.</em>', 'Construye las herramientas. <em>Aprende el oficio.</em>'],
    body: ['Wee Editor — my self-hosted workspace for running agent sessions in parallel. <a href="https://wee.cat" target="_blank" rel="noopener">wee.cat</a>', 'Wee Editor — mi espacio de trabajo autoalojado para ejecutar sesiones de agentes en paralelo. <a href="https://wee.cat" target="_blank" rel="noopener">wee.cat</a>'],
    items: [
      { title: ['Session per worktree', 'Una sesión por worktree'], body: ['Multi-agent orchestration', 'Orquestación multiagente'] },
      { title: ['Granular permissions', 'Permisos granulares'], body: ['Guardrails in code', 'Barandillas en código'] },
      { title: ['One view of the crew', 'Una vista de la tripulación'], body: ['Solving the visibility problem', 'Resolviendo el problema de visibilidad'] },
    ],
  },
  {
    id: 'hostile', layout: 'cards', audio: '15',
    notes: ['When your agent IS the threat model, guardrails become existential. Never run on production. Require written authorization. Human-verify every finding.',
            'Cuando tu agente ES el modelo de amenaza, las barandillas se vuelven existenciales. Nunca en producción. Exige autorización por escrito. Verifica cada hallazgo con humanos.'],
    eyebrow: ['Agents as pentesters', 'Agentes como pentesters'],
    heading: ['When your agent <em>is</em> the threat model.', 'Cuando tu agente <em>es</em> el modelo de amenaza.'],
    items: [
      { title: ['Never production', 'Nunca en producción'], body: ['A SQL injection test against prod isn’t a test. It’s an incident.', 'Un test de inyección SQL contra producción no es un test. Es un incidente.'] },
      { title: ['Written authorisation', 'Autorización por escrito'], body: ['From whoever controls every system in scope.', 'De quien controle cada sistema en alcance.'] },
      { title: ['Human-verify findings', 'Verificación humana'], body: ['Agents hallucinate vulnerabilities, too.', 'Los agentes también alucinan vulnerabilidades.'] },
    ],
  },
  {
    id: 'crew', layout: 'crew', audio: '16',
    notes: ['This is the central metaphor of the book. You are the captain. The agents are your crew. The codebase is the ship. The crew is replaceable. The ship is not.',
            'Esta es la metáfora central del libro. Tú eres el capitán. Los agentes son tu tripulación. La base de código es el barco. La tripulación es reemplazable. El barco no.'],
    eyebrow: ['The crew metaphor', 'La metáfora de la tripulación'],
    heading: ['The crew is disposable. <em>The ship is not.</em>', 'La tripulación es desechable. <em>El barco no.</em>'],
    items: [
      { title: ['Hull', 'Casco'], body: ['Your codebase', 'Tu base de código'] },
      { title: ['Rigging', 'Aparejo'], body: ['Conventions', 'Convenciones'] },
      { title: ['Soundings', 'Sondeos'], body: ['Tests', 'Tests'] },
      { title: ['Log', 'Bitácora'], body: ['Memory', 'Memoria'] },
      { title: ['Captain', 'Capitán'], body: ['You', 'Tú'] },
      { title: ['Crew', 'Tripulación'], body: ['Agents', 'Agentes'] },
    ],
  },
  {
    id: 'cta', layout: 'cta', audio: '17',
    notes: ['The call to action. Don’t wait. Open your terminal tonight. Pick a real task. Let the agent try. You’ll learn more in one hour than in a week of reading.',
            'La llamada a la acción. No esperes. Abre tu terminal esta noche. Elige una tarea real. Deja que el agente lo intente. Aprenderás más en una hora que en una semana de lectura.'],
    eyebrow: ['Go build something', 'Ve a construir algo'],
    heading: ['Tonight — not tomorrow — <em>open your terminal.</em>', 'Esta noche — no mañana — <em>abre tu terminal.</em>'],
    body: ['The book is free, in four languages. Second edition, September 2026.', 'El libro es gratuito, en cuatro idiomas. Segunda edición, septiembre de 2026.'],
  },
];
const total = slides.length;
const t = (v?: T) => v ? `<span class="t-en">${v[0]}</span><span class="t-es" lang="es">${v[1]}</span>` : '';
---

<BaseLayout
  title="The Agentic Crew — Presentation (Second Edition)"
  description="An interactive, narrated presentation of The Agentic Crew, second edition: what agents are, how they fail, context engineering, the agent attack surface, cloud agents, and building your own."
>
  <div class="home deck" id="deck" data-lang="en">
    <div class="deck__bg" aria-hidden="true"><Helm size="100%" stroke={0.5} /></div>

    <header class="deck__top">
      <a href="/" class="deck__brand"><Helm size={22} stroke={5} /> The Agentic Crew</a>
      <div class="deck__tools">
        <div class="seg" role="group" aria-label="Language">
          <button type="button" data-set-lang="en" aria-pressed="true">EN</button>
          <button type="button" data-set-lang="es" aria-pressed="false">ES</button>
        </div>
        <button type="button" class="icon-btn" data-notes-toggle aria-pressed="false" title="Speaker notes (N)">Notes</button>
        <button type="button" class="icon-btn" data-fullscreen title="Fullscreen (F)">⤢</button>
      </div>
    </header>

    <main class="deck__stage" aria-live="polite">
      {slides.map((s, i) => (
        <section class={`sl sl--${s.layout}`} data-i={i} data-audio={s.audio ?? ''} aria-hidden={i === 0 ? 'false' : 'true'} aria-label={`Slide ${i + 1} of ${total}`}>
          <div class="sl__inner">
            {s.layout === 'title' ? (
              <div class="sl-title">
                <span class="eyebrow"><Fragment set:html={t(['Second edition · September 2026', 'Segunda edición · Septiembre 2026'])} /></span>
                <h1>The Agentic <em>Crew</em></h1>
                <p class="sl-title__sub"><Fragment set:html={t(['Engineering in the age of AI agents', 'Ingeniería en la era de los agentes de IA'])} /></p>
                <p class="sl-title__by">Rasmus Bornhøft Schlünsen</p>
              </div>
            ) : (
              <>
                {s.eyebrow && <span class="eyebrow st"><Fragment set:html={t(s.eyebrow)} /></span>}
                {s.heading && <h2 class="sl-h st"><Fragment set:html={t(s.heading)} /></h2>}
                {s.layout === 'trifecta' && s.items && (
                  <div class="trifecta st">
                    {s.items.map((it, k) => (
                      <div class={`trifecta__c trifecta__c--${k}`}><span><Fragment set:html={t(it.title)} /></span></div>
                    ))}
                  </div>
                )}
                {s.layout === 'spectrum' && s.items && (
                  <ol class="spectrum st">
                    {s.items.map((it, k) => (
                      <li class={k === 2 ? 'is-focus' : ''}>
                        <span class="spectrum__n">{String(k).padStart(2, '0')}</span>
                        <strong><Fragment set:html={t(it.title)} /></strong>
                        {it.body && <p><Fragment set:html={t(it.body)} /></p>}
                      </li>
                    ))}
                  </ol>
                )}
                {s.layout === 'loop' && s.items && (
                  <ol class="loop st">
                    {s.items.map((it, k) => (
                      <li>
                        <span class="loop__n">{['i', 'ii', 'iii'][k]}</span>
                        <strong><Fragment set:html={t(it.title)} /></strong>
                        {it.body && <p><Fragment set:html={t(it.body)} /></p>}
                      </li>
                    ))}
                  </ol>
                )}
                {s.layout === 'versus' && s.items && (
                  <div class="versus st">
                    {s.items.map((it) => (
                      <div class="versus__col">
                        <strong><Fragment set:html={t(it.title)} /></strong>
                        {it.body && <p><Fragment set:html={t(it.body)} /></p>}
                      </div>
                    ))}
                  </div>
                )}
                {s.layout === 'crew' && s.items && (
                  <dl class="crewmap st">
                    {s.items.map((it) => (
                      <div><dt><Fragment set:html={t(it.title)} /></dt><dd><Fragment set:html={t(it.body)} /></dd></div>
                    ))}
                  </dl>
                )}
                {(s.layout === 'cards' || s.layout === 'statement') && s.items && (
                  <div class={`cards cards--${s.items.length} st`}>
                    {s.items.map((it) => (
                      <article class="card">
                        {it.tag && <span class="card__tag"><Fragment set:html={t(it.tag)} /></span>}
                        <strong><Fragment set:html={t(it.title)} /></strong>
                        {it.body && <p><Fragment set:html={t(it.body)} /></p>}
                      </article>
                    ))}
                  </div>
                )}
                {s.body && <p class="sl-body st"><Fragment set:html={t(s.body)} /></p>}
                {s.layout === 'cta' && (
                  <div class="cta st">
                    <a class="btn btn--brass" href="/#download"><Fragment set:html={t(['Read the book — free', 'Lee el libro — gratis'])} /></a>
                    <a class="btn btn--ghost" href="/"><Fragment set:html={t(['theagenticcrew.com', 'theagenticcrew.com'])} /></a>
                  </div>
                )}
              </>
            )}
          </div>
          <template class="sl-notes"><Fragment set:html={t(s.notes)} /></template>
        </section>
      ))}
    </main>

    <aside class="deck__notes" data-notes hidden>
      <span class="eyebrow"><Fragment set:html={t(['Speaker notes', 'Notas del orador'])} /></span>
      <div data-notes-body></div>
    </aside>

    <footer class="deck__bar">
      <button type="button" class="icon-btn" data-prev aria-label="Previous slide">←</button>
      <button type="button" class="play" data-play aria-pressed="false">
        <span class="play__icon" aria-hidden="true">▶</span>
        <span class="play__label"><Fragment set:html={t(['Play with narration', 'Reproducir con narración'])} /></span>
      </button>
      <div class="deck__progress" aria-hidden="true"><span data-progress></span></div>
      <span class="deck__status" data-status></span>
      <span class="deck__count"><b data-count>1</b> / {total}</span>
      <button type="button" class="icon-btn" data-next aria-label="Next slide">→</button>
    </footer>
  </div>
</BaseLayout>

<style is:global>
